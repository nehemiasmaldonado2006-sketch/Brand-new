// Prisma schema for Mission Control.
// Local dev uses SQLite (see .env DATABASE_URL). For Vercel, swap the
// datasource provider to "postgresql" and point DATABASE_URL at a
// Vercel Postgres / Neon instance — the models below don't need to change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  rateEntries   RateEntry[]
  marketEntries MarketEntry[]
  listings      Listing[]
  marketingDocs MarketingDoc[]
  hiddenTemplates HiddenTemplate[]
  contentIdeas  ContentIdea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Mission Control domain data (manually entered — no MLS/rate feed) ----

model RateEntry {
  id        String   @id @default(cuid())
  userId    String
  rate30    Float
  rate15    Float
  fha30     Float?
  loggedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model MarketEntry {
  id             String   @id @default(cuid())
  userId         String
  area           String
  medianList     Float?
  medianClosed   Float?
  daysOnMarket   Int?
  pricePerSqft   Float?
  monthsSupply   Float?
  loggedAt       DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@index([userId, area])
}

model Listing {
  id            String   @id @default(cuid())
  userId        String
  marketEntryId String?
  status        String // "active" | "closed"
  address       String
  mlsNumber     String?
  price         Float?
  specs         String?
  note          String?
  photoUrl      String?
  soldAt        DateTime?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketEntry MarketEntry? @relation(fields: [marketEntryId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

// ---- Marketing Production ----

// A saved marketing piece: either duplicated from a premade template
// ("Save to premade" / "Generate new") or built from blank. Premade
// templates themselves are defined in code (lib/marketing/*), not rows —
// this table only holds what a user has actually created or customized.
model MarketingDoc {
  id            String   @id @default(cuid())
  userId        String
  kind          String // "flyer" | "presentation" | "cma"
  name          String
  templateKey   String? // which premade template this was generated from, if any
  paletteIndex  Int?
  customBg      String?
  customFg      String?
  customAccent  String?
  useCustom     Boolean  @default(false)
  pages         Json // MarketingPage[] (see lib/marketing/types.ts)
  savedToLibrary Boolean @default(false) // appears in the library grid, not just "my docs"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

// Lets a user "delete" a premade (code-defined) template card from their
// own library view without affecting other users or the underlying asset.
model HiddenTemplate {
  id          String @id @default(cuid())
  userId      String
  templateKey String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateKey])
}

// ---- Content Studio ----

// A content idea (Reel / Carousel / Caption) with its script — click a
// card in Content Studio to read the full script, not just the idea.
model ContentIdea {
  id        String   @id @default(cuid())
  userId    String
  type      String // "Reel" | "Carousel" | "Caption"
  title     String
  script    String
  status    String   @default("Idea") // "Idea" | "Drafted" | "Scheduled" | "Posted"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
