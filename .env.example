# Postgres connection string — a local Postgres for dev, or the same
# production database (Vercel Postgres/Neon) while iterating.
DATABASE_URL="postgresql://user:password@localhost:5432/missioncontrol"

# `npx auth secret` (or `openssl rand -base64 33`) generates this.
AUTH_SECRET=""

# Base URL NextAuth uses to build callback URLs. In dev: http://localhost:3000
AUTH_URL="http://localhost:3000"

# Google Cloud OAuth client (see README for setup steps).
# Authorized redirect URI must be: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
