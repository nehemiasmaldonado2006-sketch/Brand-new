# Local dev: SQLite file. On Vercel: swap the datasource provider in
# prisma/schema.prisma to "postgresql" and point this at Vercel Postgres/Neon.
DATABASE_URL="file:./dev.db"

# `npx auth secret` (or `openssl rand -base64 33`) generates this.
AUTH_SECRET=""

# Base URL NextAuth uses to build callback URLs. In dev: http://localhost:3000
AUTH_URL="http://localhost:3000"

# Google Cloud OAuth client (see README for setup steps).
# Authorized redirect URI must be: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
